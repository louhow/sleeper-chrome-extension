{
  "manifest_version": 3,
  "name": "Sleeper Chrome Extension (unofficial)",
  "version": "1.0.0",
  "description": "Unofficial, not affiliated with Sleeper. Adds NBA Team and Matchup tabs, waivers, Premier League tabs and lineup optimizers.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.sleeper.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sleeper.com/*"
      ],
      "js": [
        "src/scoring.js",
        "src/model.js",
        "src/api.js",
        "src/ui.js",
        "src/view.js",
        "src/matchup.js",
        "src/waivers.js",
        "src/optimize.js",
        "src/nfl.js",
        "src/nflpanel.js",
        "src/card.js",
        "src/whatif.js",
        "src/bridge.js",
        "src/shared.js",
        "src/loaders.js",
        "src/nbaplayers.js",
        "src/nbacard.js",
        "src/nbaclaims.js",
        "src/nbaoptimize.js",
        "src/nflplayers.js",
        "src/nflleague.js",
        "src/nfldialog.js",
        "src/nflteam.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://sleeper.com/*"
      ],
      "js": [
        "src/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://sleeper.com/*"
      ],
      "js": [
        "src/epl/scoring.js",
        "src/epl/model.js",
        "src/epl/ui.js",
        "src/epl/team.js",
        "src/epl/matchup.js",
        "src/epl/league.js",
        "src/epl/players.js",
        "src/epl/card.js",
        "src/epl/dialogs.js",
        "src/epl/view.js",
        "src/epl/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/base.css",
        "src/panel.css",
        "src/epl/panel.css"
      ],
      "matches": [
        "https://sleeper.com/*"
      ]
    }
  ]
}
