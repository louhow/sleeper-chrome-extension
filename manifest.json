{
  "manifest_version": 3,
  "name": "Sleeper Chrome Extension (unofficial)",
  "version": "1.0.0",
  "description": "Unofficial, not affiliated with Sleeper. NBA, NFL and Premier League tabs, chopped league tools, waivers and lineup optimizers.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Sleeper Chrome Extension (unofficial): works on sleeper.com",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.sleeper.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sleeper.com/*"
      ],
      "js": [
        "src/scoring.js",
        "src/model.js",
        "src/api.js",
        "src/ui.js",
        "src/bridge.js",
        "src/shared.js",
        "src/chat.js",
        "src/settings-view.js",
        "src/settings.js",
        "src/loaders.js",
        "src/nba/week.js",
        "src/nba/panel-view.js",
        "src/nba/matchup-view.js",
        "src/nba/waivers-view.js",
        "src/nba/optimize-view.js",
        "src/nba/card-view.js",
        "src/nba/what-if-view.js",
        "src/nba/nav-view.js",
        "src/nba/players.js",
        "src/nba/card.js",
        "src/nba/waivers.js",
        "src/nba/optimize.js",
        "src/nba/nav.js",
        "src/nba/session.js",
        "src/nfl/ui.js",
        "src/nfl/panel-view.js",
        "src/nfl/optimize-view.js",
        "src/nfl/league-view.js",
        "src/nfl/chop-view.js",
        "src/nfl/players.js",
        "src/nfl/league.js",
        "src/nfl/chop.js",
        "src/nfl/optimize.js",
        "src/nfl/panel.js",
        "src/nfl/session.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://sleeper.com/*"
      ],
      "js": [
        "src/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://sleeper.com/*"
      ],
      "js": [
        "src/epl/scoring.js",
        "src/epl/model.js",
        "src/epl/ui.js",
        "src/epl/team-view.js",
        "src/epl/matchup-view.js",
        "src/epl/league-view.js",
        "src/epl/players-view.js",
        "src/epl/card-view.js",
        "src/epl/dialogs-view.js",
        "src/epl/panel-view.js",
        "src/epl/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/base.css",
        "src/panel.css",
        "src/epl/panel.css"
      ],
      "matches": [
        "https://sleeper.com/*"
      ]
    }
  ]
}
